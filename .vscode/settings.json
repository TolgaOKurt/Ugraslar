{
  "c-cpp-compile-run.c-compiler": "C:\\TDM-GCC-64\\bin\\gcc.exe",
  "c-cpp-compile-run.cpp-compiler": "C:\\TDM-GCC-64\\bin\\g++.exe",
  "c-cpp-compile-run.c-flags": "-Wall -Wextra -O3 -finput-charset=UTF-8 -fexec-charset=UTF-8",
  "c-cpp-compile-run.cpp-flags": "-Wall -Wextra -O3 -finput-charset=UTF-8 -fexec-charset=UTF-8",
  "c-cpp-compile-run.output-location": "${workspaceFolder}",
  "c-cpp-compile-run.run-in-external-terminal": false,
  "c-cpp-compile-run.save-before-compile": true,
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.executorMap": {
    "c": "cd \"$dir\" ; gcc \"$fileName\" -O3 -finput-charset=UTF-8 -fexec-charset=UTF-8 -o \"$fileNameWithoutExt.exe\" ; if ($?) { .\\\"$fileNameWithoutExt.exe\" }",
    "cpp": "cd \"$dir\" ; g++ \"$fileName\" -O3 -finput-charset=UTF-8 -fexec-charset=UTF-8 -o \"$fileNameWithoutExt.exe\" ; if ($?) { .\\\"$fileNameWithoutExt.exe\" }"
  },
  "C_Cpp_Runner.msvcBatchPath": "",
  "C_Cpp_Runner.cCompilerPath": "gcc",
  "C_Cpp_Runner.cppCompilerPath": "g++",
  "C_Cpp_Runner.debuggerPath": "gdb",
  "C_Cpp_Runner.cStandard": "",
  "C_Cpp_Runner.cppStandard": "",
  "C_Cpp_Runner.useMsvc": false,
  "C_Cpp_Runner.warnings": [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wshadow",
    "-Wformat=2",
    "-Wcast-align",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wnull-dereference"
  ],
  "C_Cpp_Runner.msvcWarnings": [
    "/W4",
    "/permissive-",
    "/w14242",
    "/w14287",
    "/w14296",
    "/w14311",
    "/w14826",
    "/w44062",
    "/w44242",
    "/w14905",
    "/w14906",
    "/w14263",
    "/w44265",
    "/w14928"
  ],
  "C_Cpp_Runner.enableWarnings": true,
  "C_Cpp_Runner.warningsAsError": false,
  "C_Cpp_Runner.compilerArgs": [],
  "C_Cpp_Runner.linkerArgs": [],
  "C_Cpp_Runner.includePaths": [],
  "C_Cpp_Runner.includeSearch": [
    "*",
    "**/*"
  ],
  "C_Cpp_Runner.excludeSearch": [
    "**/build",
    "**/build/**",
    "**/.*",
    "**/.*/**",
    "**/.vscode",
    "**/.vscode/**"
  ],
  "C_Cpp_Runner.useAddressSanitizer": false,
  "C_Cpp_Runner.useUndefinedSanitizer": false,
  "C_Cpp_Runner.useLeakSanitizer": false,
  "C_Cpp_Runner.showCompilationTime": false,
  "C_Cpp_Runner.useLinkTimeOptimization": false,
  "C_Cpp_Runner.msvcSecureNoWarnings": false
}